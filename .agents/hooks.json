{
  "easy-claude": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ../.claude/scripts/antigravity/hook-bridge.cjs SessionStart",
        "timeout": 60
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ../.claude/scripts/antigravity/hook-bridge.cjs PreInvocation",
        "timeout": 60
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.claude/scripts/antigravity/hook-bridge.cjs PreToolUse",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.claude/scripts/antigravity/hook-bridge.cjs PostToolUse",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../.claude/scripts/antigravity/hook-bridge.cjs Stop",
        "timeout": 60
      }
    ]
  }
}
